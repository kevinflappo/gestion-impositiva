      "!*.db",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!.git/**",
      "!.vscode/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
