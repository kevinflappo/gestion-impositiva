{
  "name": "nueva-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "desktop": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^6.0.1",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gestion.impositiva",
    "productName": "GestionImpositiva",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
